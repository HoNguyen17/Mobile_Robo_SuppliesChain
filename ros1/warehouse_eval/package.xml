<?xml version="1.0"?>
<package format="2">
  <name>warehouse_eval</name>
  <version>0.1.0</version>
  <description>Headless scenario runner and CSV exporter for UC6 Warehouse Robot acceptance testing.</description>
  <maintainer email="dev@example.com">Warehouse Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>warehouse_mission</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>warehouse_mission</exec_depend>
</package>
